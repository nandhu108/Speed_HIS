{
  "ConnectionStrings": {
    "Default": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Jwt": {
    "Key": "",
    "Issuer": "Prixo",
    "Audience": "Prixo",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7,
    "PortalAudience": "PrixoPortal",
    "PortalAccessTokenMinutes": 15,
    "PortalRefreshTokenDays": 14
  },
  "Abdm": {
    "Enabled": false,
    "BaseUrl": "",
    "ClientId": "",
    "ClientSecret": "",
    "HipId": ""
  },
  "FileStorage": {
    "RootPath": "App_Data/uploads"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/prixo-api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
